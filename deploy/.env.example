# Copy to .env beside compose.yml on the server and fill in. Keep secrets out
# of this file: give each one as a secret reference that is resolved when the
# stack starts, for example a 1Password reference used with
#   op run -- docker compose up -d
# Database passwords end up in connection URLs, so use letters and digits only.

# Images published by CI (the images job in .github/workflows/ci.yml), e.g.
# ghcr.io/<github-owner>/salamifocus and ghcr.io/<github-owner>/salamifocus-powersync.
APP_IMAGE=ghcr.io/<github-owner>/salamifocus
POWERSYNC_IMAGE=ghcr.io/<github-owner>/salamifocus-powersync
# latest, or sha-<commit> to pin a build.
VERSION=latest

# Host directories. Postgres keeps its data under DATA_DIR/postgres; recorded
# audio will be kept in MEDIA_DIR. Back up MEDIA_DIR directly; the database is
# backed up with pg_dump (see borgmatic.example.yaml).
DATA_DIR=/path/to/data/salamifocus
MEDIA_DIR=/path/to/media/salamifocus

# The existing Docker network the HTTPS reverse proxy is on.
PROXY_NETWORK=proxy

POSTGRES_PASSWORD="op://<vault>/<item>/postgres-password"
SALAMIFOCUS_DB_PASSWORD="op://<vault>/<item>/salamifocus-db-password"
POWERSYNC_DB_PASSWORD="op://<vault>/<item>/powersync-db-password"
POWERSYNC_STORAGE_DB_PASSWORD="op://<vault>/<item>/powersync-storage-db-password"
# pnpm --filter @salamifocus/server hash-password
OWNER_PASSWORD_HASH="op://<vault>/<item>/owner-password-hash"
# openssl genpkey -algorithm ed25519 (the PEM; line breaks may be dropped)
SIGNING_KEY="op://<vault>/<item>/signing-key"
