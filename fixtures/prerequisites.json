      "expect": {
        "unavailable": {
          "compile": [
            "blocked"
          ],
          "email-steve": []
        },
        "perspectives": [
          {
            "perspective": "projects",
            "selection": [
              "report"
            ],
            "groups": [
              {
                "id": "report",
                "tasks": [
                  {
                    "id": "compile",
                    "depth": 1
                  },
                  {
                    "id": "email-steve",
                    "depth": 2
                  }
                ]
