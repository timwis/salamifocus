{
  "name": "salamifocus",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:infra": "docker compose up -d --wait",
    "dev:server": "pnpm --filter @salamifocus/server dev",
    "dev:web": "pnpm --filter @salamifocus/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter '!@salamifocus/e2e' test",
    "test:e2e:web": "pnpm --filter @salamifocus/e2e test",
    "test:e2e:android": "pnpm --filter @salamifocus/e2e test:android"
  }
}
